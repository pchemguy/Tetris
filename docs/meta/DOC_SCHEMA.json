{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Documentation Metadata Schema",
  "filename": "DOC_SCHEMA.json",
  "type": "object",

  "definitions": {

    "doc_id_type": {
      "type": "string",
      "pattern": "^[A-Z][0-9A-Z_]+$"
    },
    "url_type": {
      "type": "string",
      "format": "uri"
    },

    "doc_scope_enum": {
      "type": "string",
      "enum": [
        "global",
        "core",
        "shell",
        "testing",

        "core:core",

        "shell:renderer",
        "shell:presenter",
        "shell:input_driver",
        "shell:input_controller",
        "shell:runtime",
        "shell:cli",
        "shell:persistence",
        "shell:telemetry",

        "testing:testing"
      ]
    }
  },

  "required": [
    "doc_id",
    "name",
    "title",
    "kind",
    "scope",
    "status",
    "authority",
    "gate_applies_to",
    "phase_applies_to"
  ],

  "not": {
    "required": ["url", "urls"]
  },
  
  "properties": {

    "doc_id": {
      "$ref": "#/definitions/doc_id_type"
    },

    "name": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_.-]+\\.[A-Za-z0-9_.-]+$"
    },

    "title": { "type": "string", "minLength": 1 },

    "description": {"type": "string"},

    "kind": {
      "type": "string",
      "enum": [
        "meta",
        "control",
        "architecture",
        "spec",
        "testing",
        "api",
        "report",
        "idea"
      ]
    },

    "scope": {"$ref": "#/definitions/doc_scope_enum"},

    "status": {
      "type": "string",
      "enum": ["draft", "active", "deprecated"]
    },

    "authority": {
      "type": "string",
      "enum": ["normative", "non_normative"]
    },

    "gate_applies_to": {
      "oneOf": [
        {"type": "string", "pattern": "^(all|none|[0-9]+(-[0-9]+)?)$"},
        {"type": "number"}
      ]
    },

    "phase_applies_to": {
      "oneOf": [
        {"type": "string", "pattern": "^(all|none|[0-9]+(-[0-9]+)?)$"},
        {"type": "number"}
      ]
    },

    "supersedes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/doc_id_type"
      }
    },

    "superseded_by": {
      "oneOf": [
        { "$ref": "#/definitions/doc_id_type" },
        { "type": "null" }
      ]
    },

    "references": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/doc_id_type"
      }
    },

    "url": { "$ref": "#/definitions/url_type" },

    "urls": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/definitions/url_type" }
    }

  },

  "additionalProperties": false
}
