{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Documentation Metadata Schema",
  "filename": "DOC_SCHEMA.json",
  "type": "object",

  "required": ["doc_id", "name", "title", "status", "authority"],

  "not": {"required": ["url", "urls"]},
  
  "additionalProperties": false,

  "definitions": {

    "doc_id_type": {
      "type": "string",
      "pattern": "^[A-Z][0-9A-Z_]+$"
    },
    "url_type": {
      "type": "string",
      "format": "uri"
    }
  },

  "properties": {

    "doc_id": {"$ref": "#/definitions/doc_id_type"},
    "name": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+\\.[A-Za-z0-9_.-]+$"},
    "title": { "type": "string", "minLength": 1 },
    "description": {"type": "string"},
    "status": {"type": "string", "enum": ["draft", "active", "deprecated"]},
    "authority": {"type": "string", "enum": ["normative", "non_normative"]},

    "url": {"$ref": "#/definitions/url_type"},

    "urls": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/definitions/url_type"}
    },

    "references": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/definitions/doc_id_type"}
    }
  }
}
