{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Documentation Metadata Schema",
  "type": "object",

  "definitions": {

    "doc_id_type": {
      "type": "string",
      "pattern": "^[A-Z][0-9A-Z_]+$"
    },

    "doc_scope_enum": {
      "type": "string",
      "enum": [
        "global",
        "core",
        "shell",
        "testing",

        "core:core",

        "shell:renderer",
        "shell:presenter",
        "shell:input_driver",
        "shell:input_controller",
        "shell:runtime",
        "shell:cli",
        "shell:persistence",
        "shell:telemetry",

        "testing:testing"
      ]
    }
  },

  "required": [
    "doc_id",
    "doc_title",
    "doc_kind",
    "doc_scope",
    "doc_status",
    "doc_authority",
    "gate_applies_to",
    "phase_applies_to"
  ],

  "properties": {

    "doc_id": {
      "$ref": "#/definitions/doc_id_type"
    },

    "doc_title": {
      "type": "string",
      "minLength": 1
    },

    "doc_kind": {
      "type": "string",
      "enum": [
        "control",
        "architecture",
        "decomposition",
        "spec",
        "oracle",
        "api",
        "map",
        "report",
        "idea"
      ]
    },

    "doc_scope": {
      "$ref": "#/definitions/doc_scope_enum"
    },

    "doc_status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "deprecated"
      ]
    },

    "doc_authority": {
      "type": "string",
      "enum": [
        "normative",
        "non_normative"
      ]
    },

    "gate_applies_to": {
      "type": "string",
      "pattern": "^(all|none|[0-9]+(-[0-9]+)?)$"
    },

    "phase_applies_to": {
      "type": "string",
      "pattern": "^(all|none|[0-9]+(-[0-9]+)?)$"
    },

    "supersedes": {
      "type": "array",
      "default": [],
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/doc_id_type"
      }
    },

    "superseded_by": {
      "oneOf": [
        { "$ref": "#/definitions/doc_id_type" },
        { "type": "null" }
      ],
      "default": null
    },

    "references": {
      "type": "array",
      "default": [],
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/doc_id_type"
      }
    }
  },

  "additionalProperties": false
}
