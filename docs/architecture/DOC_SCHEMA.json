{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Documentation Metadata Schema",
  "type": "object",

  "definitions": {
    "doc_id_type": {
      "type": "string",
      "pattern": "^[0-9A-Za-z_]+(\\.[0-9A-Za-z_]+)*$"
    }
  },

  "required": [
    "doc_id",
    "doc_title",
    "doc_kind",
    "doc_scope",
    "doc_status",
    "doc_authority",
    "gate_applies_to",
    "phase_applies_to",
    "supersedes",
    "superseded_by",
    "references"
  ],

  "properties": {

    "doc_id": {
      "$ref": "#/definitions/doc_id_type"
    },

    "doc_title": {
      "type": "string",
      "minLength": 1
    },

    "doc_kind": {
      "type": "string",
      "enum": [
        "control",
        "architecture",
        "decomposition",
        "spec",
        "oracle",
        "api",
        "map",
        "report",
        "idea"
      ]
    },

    "doc_scope": {
      "type": "string",
      "pattern": "^(global|core|shell|component:[a-z_]+)$"
    },

    "doc_status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "deprecated"
      ]
    },

    "doc_authority": {
      "type": "string",
      "enum": [
        "normative",
        "non_normative"
      ]
    },

    "gate_applies_to": {
      "type": "string",
      "pattern": "^(all|none|[0-9]+(-[0-9]+)?)$"
    },

    "phase_applies_to": {
      "type": "string",
      "pattern": "^(all|none|[0-9]+(-[0-9]+)?)$"
    },

    "supersedes": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/doc_id_type"
      }
    },

    "superseded_by": {
      "oneOf": [
        { "$ref": "#/definitions/doc_id_type" },
        { "type": "null" }
      ]
    },

    "references": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/doc_id_type"
      }
    }
  },

  "additionalProperties": false
}
