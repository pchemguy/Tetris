{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Documentation Metadata Schema",
  "type": "object",
  "required": [
    "doc_id",
    "doc_title",
    "doc_kind",
    "doc_scope",
    "doc_status",
    "doc_authority",
    "gate_applies_to",
    "phase_applies_to",
    "supersedes",
    "superseded_by",
    "references"
  ],
  "properties": {
    "doc_id": {
      "type": "string",
      "pattern": "^[0-9A-Za-z_]+(\\.[0-9A-Za-z_]+)*$"
    },
    "doc_title": {
      "type": "string"
    },
    "doc_kind": {
      "type": "string",
      "enum": [
        "control",
        "architecture",
        "decomposition",
        "spec",
        "oracle",
        "api",
        "map",
        "report",
        "idea"
      ]
    },
    "doc_scope": {
      "type": "string",
      "pattern": "^(global|core|shell|component:[a-z_]+)$"
    },
    "doc_status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "deprecated"
      ]
    },
    "doc_authority": {
      "type": "string",
      "enum": [
        "normative",
        "non_normative"
      ]
    },
    "gate_applies_to": {
      "type": "string",
      "pattern": "^(all|none|[0-9]+(-[0-9]+)?)$"
    },
    "phase_applies_to": {
      "type": "string",
      "pattern": "^(all|none|[0-9]+(-[0-9]+)?)$"
    },
    "supersedes": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z0-9_]+$"
      }
    },
    "superseded_by": {
      "type": ["string", "null"],
      "pattern": "^[A-Z0-9_]+$"
    },
    "references": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z0-9_]+$"
      }
    }
  },
  "additionalProperties": false
}
